#!/usr/bin/env bash
# Refuse a force-push to main. A non-fast-forward push there rewrites history
# every other clone has already fetched, and the recovery is manual.
#
#   git config core.hooksPath .githooks    # once per clone
#   git push --no-verify                   # the deliberate override
#
# git gives a hook no --force flag, so force is inferred: a push whose remote
# tip is not an ancestor of what is being pushed. --force-with-lease looks
# identical from here and is refused too.

set -uo pipefail

bad=0

while read -r _local_ref local_sha remote_ref remote_sha; do
  case $remote_ref in
  refs/heads/main | refs/heads/master) ;;
  *) continue ;;
  esac

  branch=${remote_ref#refs/heads/}

  # git spells "no such object" as an all-zero sha, at whatever width the
  # repository's object format uses.
  if [[ $local_sha =~ ^0+$ ]]; then
    echo "pre-push: refusing to delete $branch on the remote" >&2
    bad=1
    continue
  fi

  # A branch that does not exist on the remote yet cannot be rewritten.
  [[ $remote_sha =~ ^0+$ ]] && continue

  if ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    echo "pre-push: $branch is at $remote_sha on the remote, which is not in" >&2
    echo "  this clone -- fetch before pushing so the push can be shown to" >&2
    echo "  fast-forward." >&2
    bad=1
    continue
  fi

  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
    echo "pre-push: refusing a force-push to $branch" >&2
    echo "  remote $remote_sha is not an ancestor of $local_sha" >&2
    echo "  rebase onto the remote tip instead of rewriting it." >&2
    bad=1
  fi
done

exit "$bad"
